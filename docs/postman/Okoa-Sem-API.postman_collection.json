{
  "info": {
    "name": "Okoa Sem API",
    "description": "Local API collection for Okoa Sem. Import the Okoa Sem Local environment and enable cookies.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Health",
      "item": [
        {
          "name": "Health Check",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}{{apiPrefix}}/health",
            "description": "Basic API health check."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 200', function () { pm.response.to.have.status(200); });",
                  "pm.test('Status ok', function () { pm.expect(pm.response.json().status).to.eql('ok'); });"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "Database Health Check",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}{{apiPrefix}}/health/database",
            "description": "PostgreSQL connectivity check."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 200', function () { pm.response.to.have.status(200); });"
                ],
                "type": "text/javascript"
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Authentication",
      "item": [
        {
          "name": "Register",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"fullName\": \"Test Student\",\n  \"email\": \"student@example.com\",\n  \"password\": \"StrongPass1\"\n}"
            },
            "url": "{{baseUrl}}{{apiPrefix}}/auth/register",
            "description": "Register a new student account."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 201 or 409', function () { pm.expect([201,409]).to.include(pm.response.code); });"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "Login",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"student@example.com\",\n  \"password\": \"StrongPass1\"\n}"
            },
            "url": "{{baseUrl}}{{apiPrefix}}/auth/login",
            "description": "Authenticate and set the session cookie."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 200', function () { pm.response.to.have.status(200); });",
                  "pm.test('User returned', function () { pm.expect(pm.response.json().data.email).to.eql('student@example.com'); });"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "Current User",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}{{apiPrefix}}/auth/me",
            "description": "Retrieve the authenticated user profile."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 200', function () { pm.response.to.have.status(200); });",
                  "pm.test('No password hash exposed', function () { pm.expect(JSON.stringify(pm.response.json())).to.not.include('password'); });"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "Logout",
          "request": {
            "method": "POST",
            "header": [],
            "url": "{{baseUrl}}{{apiPrefix}}/auth/logout",
            "description": "Revoke the current session."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 204', function () { pm.response.to.have.status(204); });"
                ],
                "type": "text/javascript"
              }
            }
          ]
        }
      ]
    }
  ]
}
